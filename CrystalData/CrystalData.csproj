<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

    <PackageId>CrystalData</PackageId>
    <Authors>archi-Doc</Authors>
    <Product>CrystalData</Product>
    <Description>CrystalData is a simple and versatile storage engine for C#.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/archi-Doc/CrystalData</PackageProjectUrl>
    <RepositoryUrl>https://github.com/archi-Doc/CrystalData</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arc.Collections" Version="2.1.0" />
    <PackageReference Include="Arc.Threading" Version="0.55.0" />
    <PackageReference Include="Arc.Crypto" Version="2.1.0" />
    <PackageReference Include="Arc.Unit" Version="0.49.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Tinyhand" Version="0.148.0" />
    <PackageReference Include="ValueLink" Version="0.122.0" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="..\stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="UserInterface\Strings\strings-en.tinyhand" />
    <EmbeddedResource Include="UserInterface\Strings\strings-ja.tinyhand" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Generated\*" />
  </ItemGroup>

</Project>
